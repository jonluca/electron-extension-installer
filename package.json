{
  "name": "electron-extension-installer",
  "version": "0.0.0-development",
  "description": "Install any extension into electron",
  "keywords": [
    "devtools",
    "electron",
    "react"
  ],
  "homepage": "https://github.com/jonluca/electron-extension-installer",
  "bugs": {
    "url": "https://github.com/jonluca/electron-extension-installer/issues"
  },
  "license": "MIT",
  "author": "Jonluca DeCaro <electronextension@jonlu.ca>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonluca/electron-extension-installer.git"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "README.md"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepublishOnly": "yarn build",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "build": "rimraf dist/* && tsc -p tsconfig.json",
    "test": "yarn build && node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "electron": "^43.2.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "rimraf": "^6.1.3",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "electron": ">=36.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
